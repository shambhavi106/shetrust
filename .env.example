# ─── SheTrust Environment Variables ───────────────────
# Copy this file to .env and fill in your values

# ── Backend ──────────────────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas recommended)
# Format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/shetrust
MONGODB_URI=mongodb://localhost:27017/shetrust

# JWT secret (use a long random string in production)
JWT_SECRET=shetrust_super_secret_change_in_production_abc123

# JWT token expiry
JWT_EXPIRES_IN=30d

# ── Frontend (Vite exposes vars prefixed with VITE_) ──
# Mapbox public token — get one free at https://mapbox.com
VITE_MAPBOX_TOKEN=pk.eyJ1IjoiZGVtbyIsImEiOiJja2x5eHh4eHgifQ.REPLACE_WITH_YOUR_TOKEN

# API base URL — backend URL
VITE_API_URL=http://localhost:5000/api

# ── Bengaluru map defaults ────────────────────────────
VITE_MAP_CENTER_LNG=77.5946
VITE_MAP_CENTER_LAT=12.9716
VITE_MAP_ZOOM=12
