# ── SheTrust Backend Environment ─────────────────────
# STEP 1: Replace the MONGODB_URI below with your Atlas connection string
# STEP 2: Save this file as .env (remove the .example extension)

PORT=5000
NODE_ENV=development

# Get free MongoDB Atlas at: https://cloud.mongodb.com
# Click: New Project → Free M0 Cluster → Connect → Drivers → copy the URI
# Replace <username> and <password> with your Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shetrust?retryWrites=true&w=majority

# Leave these as-is for local development
JWT_SECRET=shetrust_dev_jwt_secret_replace_in_production
JWT_EXPIRES_IN=30d

# ── Production CORS ──────────────────────────────────
# After deploying frontend to Vercel, paste the URL here
# e.g. https://shetrust.vercel.app
FRONTEND_URL=

# ── Gemini AI (for chat feature) ─────────────────────
GEMINI_API_KEY=

# ── Web Push (VAPID) — for browser push notifications ─────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:shetrust@yourdomain.com

# ── SMTP (email notifications) ────────────────────────────────────────
# Any SMTP provider: Resend, Postmark, Gmail, SendGrid, etc.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM="SheTrust <noreply@shetrust.app>"

# ── Optional features (install packages to enable) ───────────────────
# npm i multer         → photo upload on incident reports
# npm i nodemailer     → email notifications
# npm i web-push       → Web Push browser notifications
